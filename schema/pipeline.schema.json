{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schema definition for a software factory pipeline.",
  "$defs": {
    "job": {
      "type": "object",
      "properties": {
        "stage": { "type": "string" },
        "type": { "type": "string" },
        "script": { "type": "array", "items": { "type": "string" } },
        "variables": {
          "type": "object",
          "description": "Environment variables for the job",
          "additionalProperties": { "type": "string" }
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Path to a file or folder to preserve as an artifact for subsequent jobs in the pipeline."
              }
            }
          },
          "required": ["paths"]
        },
        "on_fail": {
          "type": "string",
          "description": "Stage to reset to if this job fails. All jobs in the specified stage will be re-run. Artifacts are *not* reset, i.e., an artifact generated by a failed job will be available in the stage backtracked to."
        }
      },
      "required": ["type", "script", "stage"]
    },
    "container-job": {
      "$ref": "#/$defs/job",
      "properties": {
        "type": { "const": "container" },
        "image": { "type": "string", "description": "The container image." },
        "entrypoint": { "type": "array", "items": { "type": "string" } }
      },
      "unevaluatedProperties": false
    },
    "remote-ssh-job": {
      "$ref": "#/$defs/job",
      "properties": {
        "type": { "const": "remote_ssh" },
        "hostname": { "type": "string" },
        "user": { "type": "string" },
        "working_dir": {
          "type": "string",
          "description": "The working directory on the remote host. **The contents of this directory will be wiped when the job ends.**"
        },
        "port": { "type": "number", "default": 22 }
      },
      "required": ["hostname", "user", "working_dir"],
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "additionalProperties": {
    "oneOf": [
      { "$ref": "#/$defs/container-job" },
      { "$ref": "#/$defs/remote-ssh-job" }
    ]
  },
  "properties": {
    "stages": {
      "type": "array",
      "items": { "type": "string", "description": "Stage name" }
    },
    "max_backtracks": {
      "type": "number",
      "description": "The maximum number of times the pipeline is allowed to reset to an earlier stage. Used to prevent infinite loops."
    }
  },
  "required": ["stages", "max_backtracks"]
}
